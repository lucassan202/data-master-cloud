AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# SMTP para alertas de falha do Airflow
AIRFLOW__SMTP__SMTP_HOST=smtp.example.com
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_USER=
AIRFLOW__SMTP__SMTP_PASSWORD=
AIRFLOW__SMTP__SMTP_MAIL_FROM=airflow@example.com
AIRFLOW__SMTP__SMTP_STARTTLS=true
AIRFLOW__SMTP__SMTP_SSL=false

# Destinatários das notificações das DAGs, separados por vírgula
AIRFLOW_NOTIFICATION_EMAILS=lucas_san20@hotmail.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-2

# Backend remoto do Terraform (opcional; vazio usa state local)
TF_STATE_BUCKET=
TF_LOCK_TABLE=

DATABRICKS_HOST=
DATABRICKS_TOKEN=

AIRFLOW_ENV=dev
DAT_REF_CARGA=
DAT_REF_CARGA_M=
PROJECT=data-master
ECS_CLUSTER=data-master-dev-cluster
ECS_SERVICE=data-master-dev-selenium-svc
LAMBDA_SCREP=data-master-dev-screp
LAMBDA_DOWNLOAD=download-csv-consumer-dev
